{
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Geist Variable", "system-ui", "sans-serif"] }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 0.375, "unit": "rem" } },
    "md": { "$value": { "value": 0.5, "unit": "rem" } },
    "lg": { "$value": { "value": 0.75, "unit": "rem" } },
    "xl": { "$value": { "value": 1, "unit": "rem" } }
  }
}
